{
  "expo": {
    "name": "PuntEats",
    "slug": "punteats",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/punteats-icon.png",
    "notification": {
      "icon": "./assets/branding/punteats-icon.png",
      "color": "#1B7D3C",
      "iosDisplayInForeground": true
    },
    "scheme": [
      "punteats",
      "com.googleusercontent.apps.964294676461-l1sggb0f3cuq8ard65ihhskenie7irlb"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.punteats.app",
      "icon": "./assets/branding/punteats-icon.png",
      "supportsTablet": true,
      "buildNumber": "1",
      "jsEngine": "hermes",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PuntEats uses your location to track live food delivery and taxi rides.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.964294676461-l1sggb0f3cuq8ard65ihhskenie7irlb"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.punteats.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/punteats-icon.png",
        "backgroundColor": "#1B7D3C"
      },
      "notification": {
        "icon": "./assets/branding/punteats-icon.png",
        "color": "#1B7D3C"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "jsEngine": "hermes"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/punteats-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow PuntEats to access your location to find your delivery address.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B7D3C",
          "image": "./assets/branding/punteats-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "newArchEnabled": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d477c26-e308-4b53-80c3-ed5c2df92d38"
      }
    },
    "owner": "punteats",
    "updates": {
      "url": "https://u.expo.dev/9d477c26-e308-4b53-80c3-ed5c2df92d38"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}