{
  "expo": {
    "name": "punteats",
    "slug": "punteats",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "punteats",
      "com.googleusercontent.apps.964294676461-l1sggb0f3cuq8ard65ihhskenie7irlb"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.puntland.punteats",
      "icon": "./assets/images/puntgo_logo.png",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.964294676461-l1sggb0f3cuq8ard65ihhskenie7irlb"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.puntland.punteats",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B7D3C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "___YOUR_PROJECT_SLUG___",
          "organization": "___YOUR_ORG_SLUG___"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
